# Live Meta calls are OFF unless you deliberately enable them.
# Copy to .env locally. Never commit .env or a real key.
LESSONTRACE_ENABLE_META=0
LESSONTRACE_META_API_KEY=
# Local conservative request reservations, NOT an account billing limit.
# Each request reserves 10 cents; a tutor answer plus review normally needs two.
LESSONTRACE_TEST_LIMIT_CENTS=100
# Optional: choose an isolated directory for this clone's learner data.
# LESSONTRACE_DATA_DIR=.local
